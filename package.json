{
  "name": "quick-dash-launcher",
  "version": "0.8.0-beta.14",
  "main": "dist/main/main.js",
  "scripts": {
    "create-dev-icon": "powershell -ExecutionPolicy Bypass -File scripts/create-dev-icon.ps1",
    "dev": "cross-env APP_INSTANCE=dev VITE_PORT=9001 HOTKEY=Ctrl+Alt+A NODE_ENV=development ELECTRON_IS_DEV=1 vite",
    "dev2": "cross-env APP_INSTANCE=dev2 VITE_PORT=9002 HOTKEY=Ctrl+Alt+S NODE_ENV=development ELECTRON_IS_DEV=1 vite",
    "dev:test": "cross-env QUICK_DASH_CONFIG_DIR=./tests/dev/full VITE_PORT=9003 HOTKEY=Ctrl+Alt+T SHOW_WINDOW_ON_STARTUP=1 WINDOW_PIN_MODE=stayVisible NODE_ENV=development ELECTRON_IS_DEV=1 vite",
    "prebuild": "npm run generate-licenses",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "build:cli": "cargo build --release --manifest-path cli/Cargo.toml",
    "test:cli": "cargo test --manifest-path cli/Cargo.toml",
    "dist": "npm run build && npm run build:cli && electron-builder",
    "dist:appx": "npm run build && npm run build:cli && electron scripts/generate-appx-assets.mjs && electron-builder --win appx --x64",
    "generate-licenses": "license-checker --production --markdown --out THIRD-PARTY-NOTICES.md",
    "winrt:generate": "dynwinrt-codegen generate --namespace Windows.ApplicationModel --class-name StartupTask --output src/main/winrt/generated",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:debug": "npm run build && playwright test --debug",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:single": "node scripts/run-e2e-test.js",
    "docs:screenshots": "npm run build && playwright test -c playwright.screenshots.config.ts",
    "docs:demo-gif": "npm run build && playwright test -c playwright.demo-gif.config.ts main-demo && node scripts/make-demo-gif.mjs",
    "docs:readme-images": "npm run build && playwright test -c playwright.demo-gif.config.ts readme-images",
    "docs:demo-gif:en": "cross-env DEMO_LANG=en npm run docs:demo-gif",
    "docs:readme-images:en": "cross-env DEMO_LANG=en npm run docs:readme-images",
    "test:window-move": "tsx src/test/manual/testWindowMove.ts",
    "test:window-list": "tsx src/test/manual/testWindowList.ts",
    "debug:windows": "node scripts/debug-windows.mjs"
  },
  "keywords": [
    "launcher",
    "quick",
    "dash",
    "hotkey",
    "windows"
  ],
  "author": "masaodev",
  "license": "MIT",
  "description": "Quick access launcher for Windows with global hotkey support",
  "repository": {
    "type": "git",
    "url": "https://github.com/masaodev/quick-dash-launcher.git"
  },
  "homepage": "https://github.com/masaodev/quick-dash-launcher",
  "bugs": "https://github.com/masaodev/quick-dash-launcher/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.23",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@tanstack/react-virtual": "^3.14.13",
    "clipboard-files": "^3.0.0",
    "electron-store": "^11.0.2",
    "extract-file-icon": "^0.3.2",
    "i18next": "^26.4.4",
    "koffi": "^3.3.2",
    "minimatch": "^10.1.2",
    "pino": "^10.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.16"
  },
  "build": {
    "appId": "net.masaodev.quick-dash-launcher",
    "productName": "QuickDashLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "cli/target/release/qdl.exe",
        "to": "bin/qdl.exe"
      },
      {
        "from": "resources/native",
        "to": "resources/native",
        "filter": [
          "**/*.dll"
        ]
      }
    ],
    "icon": "assets/icon.png",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "identityName": "QuickDashLauncher",
      "applicationId": "QuickDashLauncher",
      "displayName": "QuickDashLauncher",
      "publisher": "CN=masaodev",
      "publisherDisplayName": "masaodev",
      "backgroundColor": "transparent",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "ja-JP",
        "en-US"
      ],
      "customExtensionsPath": "resources/appx/extensions.xml"
    }
  },
  "allowScripts": {
    "clipboard-files@3.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "extract-file-icon@0.3.2": true,
    "koffi@3.3.2": true
  }
}
