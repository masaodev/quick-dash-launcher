# Dependencies
node_modules/
npm-debug.log*
npm-install.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build and type check logs
type-check-*.txt

# Build output
dist/
build/
out/

# IDE and editor files
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
desktop.ini

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claude Code local settings
.claude/settings.local.json

# Electron specific
dist-electron/
release/
*.asar

# Test coverage
coverage/
.nyc_output/

# Test results
test-results/
playwright-report/
html/
.vitest/
test-output.*
*-output.log
test-run.log

# Playwright MCP
.playwright-mcp/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Auto-generated license file
THIRD-PARTY-NOTICES.md

# Test config directories (local working directories at project root)
# ルートレベルの作業用設定フォルダのみを除外
/*-config/

# Development test data runtime files
# execution-history.json は実行履歴の機能（#274 で削除）が生成していた
tests/dev/full/execution-history.json
tests/dev/full/workspace*.json
# v0.8.0-beta.5 までの QDL が生成していた（AI 編集支援。廃止済み）
tests/dev/full/last-load-report.json
tests/dev/full/README.md
tests/dev/full/schemas/

# Cache
.cache/
.parcel-cache/
.npm/

# Package manager lock files (optional - comment out if you want to commit these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# TypeScript build output
# srcディレクトリ内の.jsと.js.mapファイルを除外（ビルド成果物）
src/**/*.js
!src/main/winrt/generated/**/*.js
src/**/*.js.map
# ただし、scriptsフォルダ内の.jsファイルは除外しない（スクリプトファイルとして必要）
!scripts/**/*.js
tmpclaude-*
